         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Competition concept. Business people.</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Competition concept. Business people. Businessmen in suit pull the rope at edge of cliff, symbol of rivalry, competition, conflict. Tug of war. Vector illustration, flat design. Corporate conflicts.</rdf:li>
            </rdf:Alt>
         </dc:description>
